/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Planet textures and the soundtrack are not fingerprinted, so a week rather than forever:
# long enough that the pre-fetch on hover is reused without a round trip per file.
/textures/*
  Cache-Control: public, max-age=604800

/audio/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
